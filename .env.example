# AgroCloud AI - Environment Configuration Example
# Replace with your actual Supabase project credentials from https://supabase.com
# When these are empty or left as placeholders, AgroCloud AI operates in an interactive Local Development Mode
# allowing complete frontend, auth preview, and dashboard evaluation out-of-the-box.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Service Role Key (NEVER expose to client; used only for admin server actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Phase 4: AI Farm Intelligence & Multilingual Assistant
# ==============================================================================
# Optional: Google Gemini API Key for real-time generative conversational agronomy
# and multimodal leaf pathology image analysis. Obtain from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Optional Fallback: OpenAI API Key (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# Note: If no external AI key is configured, AgroCloud AI automatically engages
# the built-in ICAR (Indian Council of Agricultural Research) Rule-Based Agronomic
# Intelligence Engine with 100% offline-ready advisory across all 12 Indian languages.


